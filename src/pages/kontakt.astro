---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';
const crumbs = [{ name: 'Kontakt', href: '/kontakt/' }];
---
<Base
  title="Kontakt Legaards – ring 24 78 84 10"
  description="Kontakt Legaards Entreprenørforretning, Stydingvej 2, 6500 Vojens. Ring til Christian Legaard på 24 78 84 10 eller skriv til mail@legaards.dk."
  image="plads-oversigt"
  breadcrumbs={crumbs}
>
  <PageHero title="Kontakt os" lead="Vi er klar til at hjælpe dig med dit projekt. Kontakt os for en uforpligtende snak eller et tilbud." image="plads-oversigt" crumbs={crumbs} cta={false} />
  <section class="section">
    <div class="container split" style="align-items:start">
      <div class="reveal">
        <h2>Kontaktinformation</h2>
        <p style="color:var(--muted-fg)">Du er altid velkommen til at kontakte os med spørgsmål eller forespørgsler om vores ydelser.</p>
        <ul class="contact-list" style="margin-top:28px">
          <li><span class="icon-badge"><Icon name="phone" /></span><div><strong>Telefon</strong><a href={company.phoneHref}>{company.phone}</a><br /><small style="color:var(--muted-fg)">{company.contactPerson}, {company.contactTitle.toLowerCase()}</small></div></li>
          <li><span class="icon-badge"><Icon name="mail" /></span><div><strong>E-mail</strong><a href={`mailto:${company.email}`}>{company.email}</a></div></li>
          <li><span class="icon-badge"><Icon name="pin" /></span><div><strong>Adresse</strong>{company.street}<br />{company.zip} {company.city}<br /><a class="link-arrow" style="margin-top:6px" href={`https://www.google.com/maps/dir/?api=1&destination=${company.geo.lat},${company.geo.lng}`} target="_blank" rel="noopener">Rutevejledning <Icon name="arrow" /></a></div></li>
          <li><span class="icon-badge"><Icon name="clock" /></span><div><strong>Åbningstider</strong>{company.hours.map((h) => <>{h.days}: {h.time}<br /></>)}<small style="color:var(--muted-fg)">Modtagerplads: efter telefonisk aftale</small></div></li>
          <li><span class="icon-badge"><Icon name="building" /></span><div><strong>Firma</strong>{company.name}<br />CVR {company.cvr}</div></li>
        </ul>
      </div>
      <div class="hero-card reveal reveal-d1">
        <ContactForm heading="Send os en besked" intro="" />
      </div>
    </div>
  </section>
</Base>
