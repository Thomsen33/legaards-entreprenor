---
import Img from './Img.astro';
import Icon from './Icon.astro';
interface Props { exclude?: string }
const { exclude } = Astro.props;
const items = [
  { title: 'Nedbrydning', href: '/nedbrydning/', icon: 'building', img: 'nedbrydning-hus-tag', text: 'Nedrivning af bygninger i alle størrelser – fra parcelhuse til landbrug og industri. Selektivt, så mest muligt kan genbruges.' },
  { title: 'Asbest', href: '/asbest/', icon: 'shield', img: 'asbest-tag-aabnet', text: 'Certificeret screening og sanering af asbest – med sikker bortskaffelse og fuld dokumentation.' },
  { title: 'Miljørapport', href: '/miljoerapport/', icon: 'fileCheck', img: 'case-industri-hal-foer', text: 'Miljøscreening for asbest, PCB, bly og andre stoffer før nedrivning – med rapport til myndighederne.' },
  { title: 'Anlæg', href: '/anlaeg/', icon: 'shovel', img: 'anlaeg-byggemodning', text: 'Sandpuder, P-pladser, veje, udgravning og byggemodning med gravemaskiner fra 2–30 tons.' },
  { title: 'Genbrug', href: '/genbrug/', icon: 'recycle', img: 'plads-beton-laesser', text: 'Materialer fra vores opgaver sorteres og sælges videre – mindre affald og nyt liv til byggematerialerne.' },
  { title: 'Genbrugsplads', href: '/modtagerplads/', icon: 'truck', img: 'plads-lastbil-beton', text: 'Aflever sorteret beton, tegl og jern – eller køb knuste materialer til bundsikring og opfyldning.' },
].filter((i) => i.href !== exclude);
---
<div class="grid grid-3">
  {items.map((s, i) => (
    <a href={s.href} class={`card service-card reveal reveal-d${i % 3}`}>
      <div class="card-img"><Img name={s.img} alt={s.title} sizes="(max-width: 640px) 100vw, 33vw" /></div>
      <div class="card-body">
        <span class="icon-badge"><Icon name={s.icon} /></span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <span class="link-arrow">Læs mere <Icon name="arrow" /></span>
      </div>
    </a>
  ))}
</div>
