---
import Icon from './Icon.astro';
import { company } from '../data/site';
// TODO: sæt endpoint (fx Make-webhook-URL), når modtageren er besluttet. Tom = åbner mailprogram.
const ENDPOINT = '';
interface Props { heading?: string; intro?: string; subject?: boolean; compact?: boolean; defaultSubject?: string; contacts?: boolean }
const {
  heading = 'Kontakt os i dag',
  intro = 'Udfyld formularen, så kontakter vi dig hurtigt.',
  subject = true,
  compact = false,
  defaultSubject = '',
  contacts = true,
} = Astro.props;
const subjects = ['Nedbrydning', 'Asbest', 'Miljørapport', 'Anlæg', 'Genbrug', 'Aflever materialer', 'Køb materialer', 'Andet'];
const showSubject = subject && !compact;
---
<form class="form" data-lead-form data-endpoint={ENDPOINT} data-mailto={company.email}>
  {(heading || intro) && (
    <div class="form-head">
      {heading && <h2>{heading}</h2>}
      {intro && <p>{intro}</p>}
    </div>
  )}
  <div class="row">
    <label><span class="sr-only">Navn</span><input name="navn" required autocomplete="name" placeholder="Navn" /></label>
    <label><span class="sr-only">Telefon</span><input name="telefon" type="tel" required autocomplete="tel" placeholder="Tlf. nr." /></label>
  </div>
  <label><span class="sr-only">E-mail</span><input name="email" type="email" autocomplete="email" placeholder="Email" /></label>
  {showSubject && (
    <label><span class="sr-only">Emne</span>
      <select name="emne">
        <option value="">Vælg emne</option>
        {subjects.map((s) => <option selected={s === defaultSubject}>{s}</option>)}
      </select>
    </label>
  )}
  <label><span class="sr-only">Besked</span><textarea name="besked" required placeholder="Besked"></textarea></label>
  <label class="hp" aria-hidden="true">Hjemmeside<input name="website" tabindex="-1" autocomplete="off" /></label>
  <button class="btn btn-accent" type="submit">Få et godt tilbud <Icon name="send" /></button>
  <p class="form-success" role="status">Tak for din henvendelse – vi vender tilbage hurtigst muligt.</p>
  {contacts && (
    <div class="form-contacts">
      <a href={company.phoneHref}><Icon name="phone" />{company.phone}</a>
      <a href={`mailto:${company.email}`}><Icon name="mail" />{company.email}</a>
    </div>
  )}
</form>
